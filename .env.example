# QNAP RustDesk 编译期环境变量说明（仅模板，严禁填入真实密钥并提交）
# 正式打包时请在 GitHub 仓库 Settings -> Secrets and variables -> Actions 中配置以下项：

# 自建中转/ID 服务器地址（必填）
RENDEZVOUS_SERVER=rd.example.com

# 自建中转服务器公钥（必填）
RS_PUB_KEY=YOUR_PUBLIC_KEY_HERE

# 自建 API 服务器地址（可选，未部署 Pro 版可留空）
API_SERVER=

# 在线版本清单 JSON 地址（推荐填写，后续可随时切换为国内直链）
QNAP_UPDATE_MANIFEST_URL=https://github.com/al80614713/qnap-rustdesk/releases/download/manifest/update-manifest.json

# 编译兜底强制到期天数（默认 180 天，约 6 个月）
QNAP_EXPIRE_DAYS=180
